{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ClientAssertionAdmission": {
    "Enabled": false
  },
  "LiveFeedServiceAuthentication": {
    "Issuer": "dbap-live-feed-service",
    "Subject": "live-feed-service",
    "Audience": "dbap-bidding-service",
    "PublicKeyPath": "keys/live-feed-service-public.pem",
    "KeyId": "live-feed-service-v1",
    "MaximumLifetimeSeconds": 30
  },
  "Authentication": {
    "BiddingService": {
      "Issuer": "dbap-laravel",
      "Audience": "dbap-bidding-service",
      "KeyId": "bidding-service-v1",
      "PublicKeyPath": "keys/bidding-service-public.pem"
    },
    "SystemAdmin": {
      "Issuer": "dbap-system-admin",
      "Audience": "bidding-service-admin",
      "KeyId": "system-admin-development-1",
      "PublicKeyPath": "keys/system-admin-public.pem"
    }
  },
  "Database": {
    "ApplyMigrations": true,
    "SeedDemoData": true
  },
  "BidPlacement": {
    "MaxConcurrencyRetries": 2,
    "ArtificialProcessingDelayMilliseconds": 0
  }
}
