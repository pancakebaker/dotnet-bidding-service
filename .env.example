# Bidding PostgreSQL. Integration tests create their own isolated databases on this server.
ConnectionStrings__BiddingDb=Host=127.0.0.1;Port=55432;Database=auction_demo;Username=auction_app;Password=change_me_in_local_env

# Client assertion replay protection. Required when ClientAssertionAdmission:Enabled is true.
ConnectionStrings__ClientAssertionRedis=localhost:6379

# Bidding API authentication and public verification material.
Authentication__BiddingService__Issuer=dbap-laravel
Authentication__BiddingService__Audience=dbap-bidding-service
Authentication__BiddingService__KeyId=bidding-service-v1
Authentication__BiddingService__PublicKeyPath=keys/bidding-service-public.pem
Authentication__SystemAdmin__Issuer=dbap-system-admin
Authentication__SystemAdmin__Audience=bidding-service-admin
Authentication__SystemAdmin__KeyId=system-admin-development-1
Authentication__SystemAdmin__PublicKeyPath=keys/system-admin-public.pem

# Trusted Live Feed service authentication. Live Feed retains the private key.
LiveFeedServiceAuthentication__Issuer=dbap-live-feed-service
LiveFeedServiceAuthentication__Subject=live-feed-service
LiveFeedServiceAuthentication__Audience=dbap-bidding-service
LiveFeedServiceAuthentication__KeyId=live-feed-service-v1
LiveFeedServiceAuthentication__PublicKeyPath=keys/live-feed-service-public.pem

# Admission and database startup policy.
ClientAssertionAdmission__Enabled=false
Database__ApplyMigrations=true
Database__SeedDemoData=true

# Outbox Publisher RabbitMQ overrides. The worker also supports its appsettings section.
OUTBOX_PUBLISHER_RABBITMQ_HOST=localhost
OUTBOX_PUBLISHER_RABBITMQ_PORT=5672
OUTBOX_PUBLISHER_RABBITMQ_USERNAME=auction
OUTBOX_PUBLISHER_RABBITMQ_PASSWORD=change_me_in_local_env
OUTBOX_PUBLISHER_RABBITMQ_VHOST=/
OUTBOX_PUBLISHER_RABBITMQ_EXCHANGE=auction.events
OUTBOX_PUBLISHER_RABBITMQ_DEBUG_QUEUE=auction.events.debug
OUTBOX_PUBLISHER_RABBITMQ_DECLARE_DEBUG_QUEUE=true
